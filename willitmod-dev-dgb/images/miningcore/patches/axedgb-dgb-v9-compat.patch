+    private object GetJobParamsForConnection(BitcoinWorkerContext context, object jobParams, bool forceClean = false)
+    {
+        if(coin.Symbol != "DGB" || !context.VersionRollingMask.HasValue || jobParams is not object[] source)
+            return jobParams;
+
+        var result = source.ToArray();
+
+        if(result.Length > 5 && result[5] is string versionHex &&
+            uint.TryParse(versionHex, NumberStyles.HexNumber, CultureInfo.InvariantCulture, out var version))
+        {
+            // DGB v9 uses BIP9 bit 23 inside the standard rolling region. NerdQAxe
+            // firmware ORs ASIC-rolled bits into the advertised base and submits an
+            // XOR delta. Clearing negotiated rolling bits in the per-client base makes
+            // that delta identical to BIP310 version bits without altering non-rolling
+            // clients or Miningcore's original block-template version.
+            result[5] = (version & ~context.VersionRollingMask.Value).ToStringHex8();
+        }
+
+        if(forceClean && result.Length > 0)
+            result[^1] = true;
+
+        return result;
+    }
